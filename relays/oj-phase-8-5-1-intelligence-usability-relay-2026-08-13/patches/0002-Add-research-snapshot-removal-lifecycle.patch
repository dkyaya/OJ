+  ('52000000-0000-0000-0000-000000000002', '51000000-0000-0000-0000-000000000002', '53000000-0000-0000-0000-000000000002', 'market_pricing', now(), 'User B immutable fixture.', '{"implied_volatility": 0.3}');
