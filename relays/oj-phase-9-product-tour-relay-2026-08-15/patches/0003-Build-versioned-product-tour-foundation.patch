+@media(max-width:360px){.tour-invitation footer{grid-template-columns:1fr}.product-tour-card{left:6px;right:6px;bottom:calc(6px + env(safe-area-inset-bottom));padding:15px}.product-tour-card>p{font-size:11px}.product-tour-card footer{gap:4px}.product-tour-card footer button{font-size:9px}}
