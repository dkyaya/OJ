{
  "name": "oj-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate:data": "NODE_PATH=./node_modules tsx ../scripts/validate-trade-notes.ts",
    "data:build": "NODE_PATH=./node_modules tsx ../scripts/build-trade-data.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run validate:data && npm run data:build && tsc -b && vite build"
  },
  "dependencies": { "@tanstack/react-table": "^8.21.3", "framer-motion": "^12.12.1", "lucide-react": "^0.468.0", "react": "^19.0.0", "react-dom": "^19.0.0", "react-router-dom": "^7.5.3", "recharts": "^2.15.1", "zod": "^3.24.2" },
  "devDependencies": { "@eslint/js": "^9.24.0", "@types/node": "^22.15.0", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0", "@vitejs/plugin-react": "^4.4.1", "eslint": "^9.24.0", "eslint-plugin-react-hooks": "^5.2.0", "eslint-plugin-react-refresh": "^0.4.19", "tsx": "^4.19.3", "typescript": "~5.8.3", "typescript-eslint": "^8.29.0", "vite": "^6.3.2", "vitest": "^3.1.1" }
}
