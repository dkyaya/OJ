<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024" width="100%" height="100%">
  <defs>
    <radialGradient id="bg-glow" cx="50%" cy="30%" r="75%">
      <stop offset="0%" stop-color="#2C2C2C" />
      <stop offset="100%" stop-color="#121212" />
    </radialGradient>
    <linearGradient id="rind-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FF9500" />
      <stop offset="100%" stop-color="#D95B00" />
    </linearGradient>
  </defs>
  <!-- Rounded App Background -->
  <rect width="1024" height="1024" rx="224" fill="url(#bg-glow)" />
  <!-- Border Highlight -->
  <rect width="1020" height="1020" x="2" y="2" rx="222" fill="none" stroke="#3D3D3D" stroke-width="4" />
  
  <!-- Centered Symbol Scaled Up -->
  <g transform="translate(212, 212) scale(6)">
    <path d="M 50,0 A 50,50 0 1,0 100,50 L 84,50 A 34,34 0 1,1 50,16 Z" fill="url(#rind-gradient)" />
    <line x1="34" y1="38" x2="34" y2="72" stroke="#00C853" stroke-width="2.5" stroke-linecap="round" />
    <rect x="30.5" y="44" width="7" height="18" rx="1.5" fill="#00C853" />
    <line x1="50" y1="28" x2="50" y2="68" stroke="#D50000" stroke-width="2.5" stroke-linecap="round" />
    <rect x="46.5" y="34" width="7" height="22" rx="1.5" fill="#D50000" />
    <line x1="66" y1="22" x2="66" y2="58" stroke="#00C853" stroke-width="2.5" stroke-linecap="round" />
    <rect x="62.5" y="26" width="7" height="20" rx="1.5" fill="#00C853" />
  </g>
</svg>
